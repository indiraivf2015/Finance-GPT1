# Copy to .env and fill in values. Never commit .env to git.

NODE_ENV=production
PORT=5005
# Vite dev proxy uses the same port (optional override for frontend)
# VITE_BACKEND_PORT=5005

# Required
MONGODB_URI=mongodb://user:password@host:27017/indira-gpt?authSource=admin
MONGODB_DB_NAME=indira-gpt
JWT_SECRET=generate-a-long-random-string-here

# LLM keys (at least one provider for chat features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_QUERY=
# ANTHROPIC_MODEL_ANSWER=
GEMINI_API_KEY=

# data engine: mongo | sql
# DATA_ENGINE=mongo

# Comma-separated origins for CORS when API is called cross-origin (optional behind nginx same-origin)
# ALLOWED_ORIGINS=https://gptindira.indiraivf.in

# SMTP (optional — forgot-password email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
