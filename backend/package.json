{
  "name": "indira-gpt-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "node server.js",
    "dev:frontend": "cd ../frontend && npm run dev",
    "build": "cd ../frontend && npm run build",
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "deploy": "bash ../deploy/deploy.sh",
    "parity-latency": "node scripts/parity-latency.js",
    "install:all": "npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@duckdb/node-api": "^1.5.2-r.1",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^6.1.0",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "multer": "^2.0.2",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^8.0.1",
    "pdfkit": "^0.18.0",
    "pptxgenjs": "^4.0.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
